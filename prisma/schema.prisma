generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enumerações de Expansão de Escopo
enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  RURAL
}

enum TransactionType {
  RENT
  SALE
  SHORT_TERM
}

enum ConstructionStage {
  PLAN
  UNDER_CONSTRUCTION
  READY
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  SOLD
  UNAVAILABLE
}

model User {
  id            String     @id @default(uuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          String     @default("TENANT") // TENANT, ADVERTISER, ADMIN, BROKER
  createdAt     DateTime   @default(now())
  
  accounts      Account[]
  sessions      Session[]
  properties    Property[]
  favorites     Favorite[]
  subscriptions PushSubscription[]
  chatHistory   ChatHistory[]
  savedSearches SavedSearch[]
  broker        Broker?
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// O Escudo B2B (Agências e Corretores)
model Agency {
  id          String     @id @default(cuid())
  name        String
  cnpj        String     @unique
  logoUrl     String?
  brokers     Broker[]
  properties  Property[]
  createdAt   DateTime   @default(now())
}

model Broker {
  id          String     @id @default(cuid())
  userId      String     @unique // Conecta com o seu User do Auth.js
  agencyId    String?
  creci       String     @unique
  phone       String
  
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency      Agency?    @relation(fields: [agencyId], references: [id])
  properties  Property[]
}

model Property {
  id                String            @id @default(cuid())
  title             String
  description       String            @db.Text
  
  // Categorização Master
  category          PropertyCategory  @default(RESIDENTIAL)
  transactionType   TransactionType[] // Permite que um imóvel seja Venda E Aluguel ao mesmo tempo
  constructionStage ConstructionStage @default(READY)

  // Precificação Composta (A Morte do Preço Único)
  basePrice         Float
  condominiumFee    Float?            @default(0)
  iptuTax           Float?            @default(0)
  
  // Geometria e Estrutura Expansiva
  areaTotal         Float?
  areaUseful        Float
  bedrooms          Int
  bathrooms         Int      @default(1)
  suites            Int      @default(0)
  
  // Estacionamento Corporativo/Residencial
  parkingSpots      Int               @default(0)
  isCoveredParking  Boolean           @default(false)
  
  petFriendly       Boolean  @default(false)
  furnished         Boolean  @default(false)

  // Metadados Geográficos e Zoneamento
  lat               Float
  lng               Float
  address           String   @default("")
  city              String   @default("")
  neighborhood      String   @default("")
  state             String   @default("TO")
  heavyTraffic      Boolean? @default(false) // Vital para galpões
  featuredImage     String?
  
  // Relacionamentos B2B e Regras
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  
  brokerId          String?
  broker            Broker?  @relation(fields: [brokerId], references: [id])
  
  agencyId          String?
  agency            Agency?  @relation(fields: [agencyId], references: [id])
  
  images            PropertyImage[]
  features          PropertyFeature[]
  accessibility     Accessibility?

  viewCount         Int      @default(0) // Total de visualizações global
  isPremium         Boolean  @default(false)
  isActive          Boolean  @default(true) // Soft Delete / Imóvel Alugado
  status            PropertyStatus @default(AVAILABLE)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  favoritedBy       Favorite[]
  dailyStats        PropertyDailyStat[]
  waitlist          WaitlistLead[]
}

// O Sistema de Acessibilidade e Condomínio (Tabelas Auxiliares)
model Accessibility {
  id              String   @id @default(cuid())
  propertyId      String   @unique
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  hasRamp         Boolean  @default(false)
  hasElevator     Boolean  @default(false)
  wideDoors       Boolean  @default(false)
  tactilePaving   Boolean  @default(false)
}

model PropertyFeature {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  featureName String   // Ex: "Piscina", "Portaria 24h", "Doca Trifásica"
}

model PropertyImage {
  id         String   @id @default(uuid())
  url        String
  order      Int      @default(0)
  caption    String?
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model PropertyDailyStat {
  id         String   @id @default(uuid())
  propertyId String
  date       DateTime // O dia exato, para Time-Series
  views      Int      @default(0)
  clicks     Int      @default(0) // Cliques no WhatsApp (Leads)
  
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@unique([propertyId, date])
}

model POI {
  id        String   @id @default(uuid())
  name      String
  category  String   // ESCOLA, FARMACIA, TURISMO, COMERCIO
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  propertyId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([endpoint])
}

model ChatHistory {
  id        String   @id @default(uuid())
  userId    String
  role      String   // "user" | "assistant" | "system"
  content   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedSearch {
  id          String   @id @default(uuid())
  userId      String
  city        String?
  minBedrooms Int?
  maxPrice    Float?
  petFriendly Boolean?
  furnished   Boolean?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GeocodingCache {
  id        String   @id @default(uuid())
  query     String   @unique
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
}

model WaitlistLead {
  id         String   @id @default(uuid())
  propertyId String
  name       String
  email      String
  phone      String?
  createdAt  DateTime @default(now())
  
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([email, propertyId])
}
